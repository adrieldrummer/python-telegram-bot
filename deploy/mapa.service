[Unit]
Description=Mapa da Aprovação — plataforma de estudo
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/mapa
EnvironmentFile=/opt/mapa/.env
ExecStart=/opt/mapa/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
# proteções básicas
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
