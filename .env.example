# ============================================================
#  Operação Aprovação — plataforma de estudo (arquivo de exemplo)
#  Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# --- Identidade do produto -------------------------------------------------
APP_NOME="Operação Aprovação"
APP_ASSINATURA="Sua missão começa agora."
APP_SUBTITULO="Operação de 30 dias para Soldado PM 2ª Classe — SP"
APP_URL="https://opaprova.com"
SUPORTE_EMAIL="suporte@opaprova.com"
SUPORTE_WHATSAPP="5511999999999"

# --- Segurança -------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-esta-chave-em-producao"
# true em produção (exige HTTPS nos cookies)
COOKIE_SEGURO=false
SESSAO_DIAS=30

# --- Banco de dados --------------------------------------------------------
BANCO_CAMINHO="dados/plataforma.db"

# --- E-mail (SMTP) ---------------------------------------------------------
# Sem SMTP configurado, a plataforma entra em MODO CAIXA DE SAÍDA:
# os e-mails ficam gravados no banco e visíveis em /admin/emails.
SMTP_HOST=""
SMTP_PORTA=587
SMTP_USUARIO=""
SMTP_SENHA=""
SMTP_TLS=true
EMAIL_REMETENTE="Operação Aprovação <acesso@opaprova.com>"
EMAIL_RESPONDER_PARA="suporte@opaprova.com"

# --- Cakto (checkout + webhook) -------------------------------------------
# Link do seu checkout na Cakto (usado nos botões da página de vendas)
CAKTO_CHECKOUT_URL="https://pay.cakto.com.br/seu-produto"
# Segredo do webhook configurado no painel da Cakto.
# O endpoint valida assinatura HMAC-SHA256 e/ou token compartilhado.
CAKTO_WEBHOOK_SEGREDO=""
# Nome do cabeçalho que traz a assinatura (varia conforme a conta)
CAKTO_HEADER_ASSINATURA="x-cakto-signature"
# Aceitar webhook sem assinatura (SOMENTE para testes locais)
CAKTO_PERMITIR_SEM_ASSINATURA=false

# --- Regras da jornada -----------------------------------------------------
# true  = 1 dia liberado por dia de calendário (drip clássico)
# false = libera assim que o aluno concluir o dia anterior (ritmo livre)
JORNADA_DRIP_DIARIO=true
# Pontos gastos para antecipar a liberação do próximo dia
CUSTO_CHAVE_ANTECIPACAO=250
# Acerto mínimo (%) na missão do dia para marcar o dia como concluído
META_ACERTO_MISSAO=60

# --- Admin inicial (usado por scripts/criar_admin.py) ----------------------
ADMIN_EMAIL="admin@opaprova.com"
ADMIN_NOME="Rafael Andrade"
ADMIN_SENHA=""
